{
  "elements": [
    {
      "type": "ExpansionPanel",
      "caption": "Master / Bewässerungssteuerung",
      "items": [
        {
          "name": "PumpLeadTimeSeconds",
          "type": "NumberSpinner",
          "caption": "Pumpenvorlauf beim Sequenzstart (Sekunden)"
        },
        {
          "name": "PumpEarlyOffSeconds",
          "type": "NumberSpinner",
          "caption": "Pumpennachlauf (s, negativ = früher aus)"
        },
        {
          "name": "PauseBetweenZonesSeconds",
          "type": "NumberSpinner",
          "caption": "Pause zwischen Zonen (Sekunden)"
        },
        {
          "name": "MaxZones",
          "type": "NumberSpinner",
          "caption": "Maximale Zonen (1-10)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Darstellung",
      "items": [
        {
          "name": "HtmlFontFamily",
          "type": "ValidationTextBox",
          "caption": "Schriftart"
        },
        {
          "name": "HtmlFontSize",
          "type": "NumberSpinner",
          "caption": "Schriftgröße (px)"
        },
        {
          "name": "HtmlAccentColor",
          "type": "ValidationTextBox",
          "caption": "Akzentfarbe / Blau"
        },
        {
          "name": "HtmlTextColor",
          "type": "ValidationTextBox",
          "caption": "Textfarbe"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Pumpe",
      "items": [
        {
          "name": "PumpInstance",
          "type": "SelectInstance",
          "caption": "Pumpenaktor (Shelly oder xComfort)"
        },
        {
          "type": "Label",
          "caption": "Der Master steuert die Pumpe global. Das Modul sucht unter der Instanz automatisch die passende schaltbare Bool-Variable und schaltet diese mit RequestAction."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Aktorrückmeldung und Fehlerbenachrichtigung",
      "items": [
        {
          "type": "CheckBox",
          "name": "MonitorActuators",
          "caption": "Aktorrückmeldung überwachen (Hauptschalter)"
        },
        {
          "type": "CheckBox",
          "name": "MonitorPump",
          "caption": "Pumpenaktor überwachen"
        },
        {
          "type": "NumberSpinner",
          "name": "FeedbackWaitSeconds",
          "caption": "Wartezeit je Versuch (Sekunden)"
        },
        {
          "type": "NumberSpinner",
          "name": "FeedbackRetries",
          "caption": "Zusätzliche Schaltversuche (Standard 1)"
        },
        {
          "type": "Select",
          "name": "ActuatorFailureMode",
          "caption": "Bei Schaltfehler",
          "options": [
            {
              "caption": "Nur protokollieren",
              "value": 0
            },
            {
              "caption": "Sequenz stoppen",
              "value": 1
            }
          ]
        },
        {
          "type": "Select",
          "name": "NotificationMode",
          "caption": "Fehlerbenachrichtigung",
          "options": [
            {
              "caption": "Keine",
              "value": 0
            },
            {
              "caption": "IP-Symcon Push",
              "value": 1
            },
            {
              "caption": "Telegram",
              "value": 2
            },
            {
              "caption": "Beide",
              "value": 3
            }
          ]
        },
        {
          "type": "SelectInstance",
          "name": "PushInstance",
          "caption": "IP-Symcon Push-Instanz"
        },
        {
          "type": "SelectScript",
          "name": "TelegramScript",
          "caption": "Telegram-Sendescript (Parameter TITLE und MESSAGE)"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Neue Zone unter dieser Instanz anlegen",
      "onClick": "IRR_CreateArea($id);"
    },
    {
      "type": "Button",
      "caption": "Zonen aktualisieren",
      "onClick": "IRR_RefreshAreas($id);"
    },
    {
      "type": "Button",
      "caption": "Sequenz starten",
      "onClick": "IRR_StartManualSequence($id);"
    },
    {
      "type": "Button",
      "caption": "Sequenz stoppen",
      "onClick": "IRR_StopSequence($id);"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Master ist aktiv"
    },
    {
      "code": 200,
      "icon": "error",
      "caption": "Keine Zonen oder keine Pumpe konfiguriert"
    }
  ]
}
